# syntax=docker/dockerfile:1

# Isolated CI/test image: Go toolchain + common shells for hook e2e.
FROM golang:1.26-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    zsh \
    fish \
    ca-certificates \
    curl \
    git \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
ENV CGO_ENABLED=0
ENV GOTOOLCHAIN=local

# Pre-warm module cache when go.mod is stable (layer caching).
COPY go.mod go.sum ./
RUN go mod download

COPY . .

CMD ["make", "test-all"]
